# Der Ordner mit den Sicherungen darf nicht von aussen abrufbar sein.
# Er enthaelt zwar nur fruehere Staende der oeffentlichen Seiten, aber
# was nicht erreichbar sein muss, sollte auch nicht erreichbar sein.
RedirectMatch 404 /pflege/sicherungen/

# inhalt.php ist eine Hilfsdatei, passwort.php enthaelt den Hash des
# Passworts, anfragen.php die Anfragen fremder Menschen mit Namen,
# Adressen und Telefonnummern. Nichts davon darf von aussen abrufbar sein.
# Diese Sperre gilt zusaetzlich: Diese Dateien schuetzen sich auch selbst,
# damit der Schutz nicht davon abhaengt, ob der Server .htaccess auswertet.
<FilesMatch "^(inhalt\.php|passwort\.php|passwort\.txt|anfragen\.php|anfragen-neu\.php|anfragen\.lock)$">
  Require all denied
</FilesMatch>

# Diese Datei selbst. Apache sperrt Dateien mit .ht am Anfang zwar meist
# schon in der Grundeinstellung, aber die steht nicht ueberall gleich. Wo
# .htaccess ueberhaupt nicht ausgewertet wird (nginx), hilft auch das hier
# nicht -- dort schuetzen sich die PHP-Dateien selbst.
<FilesMatch "^\.ht">
  Require all denied
</FilesMatch>

# Kein Verzeichnislisting.
Options -Indexes
